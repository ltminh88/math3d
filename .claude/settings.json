{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Glob|Grep|Read|Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "i=; while IFS= read -r l || [ -n \"$l\" ]; do i=$i$l; done; s=${i#*\\\"session_id\\\":\\\"}; s=${s%%\\\"*}; t=${i##*\\\"tool_use_id\\\":\\\"}; t=${t%%\\\"*}; case \"$s\" in ''|.*|*[!A-Za-z0-9._-]*) s= ;; esac; case \"$t\" in ''|.*|*[!A-Za-z0-9._-]*) t= ;; esac; [ -n \"$s\" ] && [ -n \"$t\" ] && [ -e \"${TAKUMI_HOME:-$HOME/.takumi}/mod-sessions/$s/calls/$t\" ] && exit 0; printf '%s\\n' \"$i\" | exec tkm hook-exec --hook guard.jailbreak --event pre-tool-use -a claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Glob|Grep|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "i=; while IFS= read -r l || [ -n \"$l\" ]; do i=$i$l; done; s=${i#*\\\"session_id\\\":\\\"}; s=${s%%\\\"*}; t=${i##*\\\"tool_use_id\\\":\\\"}; t=${t%%\\\"*}; case \"$s\" in ''|.*|*[!A-Za-z0-9._-]*) s= ;; esac; case \"$t\" in ''|.*|*[!A-Za-z0-9._-]*) t= ;; esac; [ -n \"$s\" ] && [ -n \"$t\" ] && [ -e \"${TAKUMI_HOME:-$HOME/.takumi}/mod-sessions/$s/calls/$t\" ] && exit 0; printf '%s\\n' \"$i\" | exec tkm hook-exec --hook guard.secret-read --event pre-tool-use -a claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook convention.descriptive-name --event pre-tool-use -a claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook extension.skill --event pre-tool-use -a claude",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "i=; while IFS= read -r l || [ -n \"$l\" ]; do i=$i$l; done; s=${i#*\\\"session_id\\\":\\\"}; s=${s%%\\\"*}; t=${i##*\\\"tool_use_id\\\":\\\"}; t=${t%%\\\"*}; case \"$s\" in ''|.*|*[!A-Za-z0-9._-]*) s= ;; esac; case \"$t\" in ''|.*|*[!A-Za-z0-9._-]*) t= ;; esac; [ -n \"$s\" ] && [ -n \"$t\" ] && [ -e \"${TAKUMI_HOME:-$HOME/.takumi}/mod-sessions/$s/calls/$t\" ] && exit 0; printf '%s\\n' \"$i\" | exec tkm hook-exec --hook metrics.record --event pre-tool-use -a claude",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook session.init --event session-start -a claude",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "tkm hook-exec --hook metrics.record --event session-start -a claude",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook session.notices --event session-start -a claude",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook perf.usage-cache --event session-start -a claude",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook session.activity --event session-start -a claude",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook session.prompt-context --event user-prompt-submit -a claude",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "tkm hook-exec --hook metrics.record --event user-prompt-submit -a claude",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "tkm hook-exec --hook perf.usage-cache --event user-prompt-submit -a claude",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook session.subagent-init --event subagent-start -a claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook session.wip-checkpoint --event pre-compact -a claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook convention.quality-gate --event post-tool-use -a claude",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "i=; while IFS= read -r l || [ -n \"$l\" ]; do i=$i$l; done; s=${i#*\\\"session_id\\\":\\\"}; s=${s%%\\\"*}; t=${i##*\\\"tool_use_id\\\":\\\"}; t=${t%%\\\"*}; case \"$s\" in ''|.*|*[!A-Za-z0-9._-]*) s= ;; esac; case \"$t\" in ''|.*|*[!A-Za-z0-9._-]*) t= ;; esac; [ -n \"$s\" ] && [ -n \"$t\" ] && [ -e \"${TAKUMI_HOME:-$HOME/.takumi}/mod-sessions/$s/calls/$t\" ] && exit 0; printf '%s\\n' \"$i\" | exec tkm hook-exec --hook metrics.record --event post-tool-use -a claude",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "i=; while IFS= read -r l || [ -n \"$l\" ]; do i=$i$l; done; s=${i#*\\\"session_id\\\":\\\"}; s=${s%%\\\"*}; t=${i##*\\\"tool_use_id\\\":\\\"}; t=${t%%\\\"*}; case \"$s\" in ''|.*|*[!A-Za-z0-9._-]*) s= ;; esac; case \"$t\" in ''|.*|*[!A-Za-z0-9._-]*) t= ;; esac; [ -n \"$s\" ] && [ -n \"$t\" ] && [ -e \"${TAKUMI_HOME:-$HOME/.takumi}/mod-sessions/$s/calls/$t\" ] && exit 0; printf '%s\\n' \"$i\" | exec tkm hook-exec --hook perf.usage-cache --event post-tool-use -a claude",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Task|TaskCreate|TaskUpdate|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook session.activity --event post-tool-use -a claude",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook metrics.flush --event stop -a claude",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "tkm hook-exec --hook session.activity --event stop -a claude",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook metrics.flush --event session-end -a claude",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkm hook-exec --hook session.activity --event subagent-stop -a claude",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "refreshInterval": 30,
    "command": "tkm statusline"
  }
}