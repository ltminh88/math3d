{
  "name": "number-stone-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/sync/supabase-database-types.ts",
    "icons": "cd public && pwa-assets-generator --preset minimal-2023 icons/icon.svg"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "idb": "8.0.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "fake-indexeddb": "6.2.6",
    "supabase": "2.121.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}
